---
# ansible-lint configuration directives
# Documentation: https://ansible-lint.readthedocs.io
exclude_paths:
  - library/
  - molecule/default/roles
  - molecule/email/roles

# Return non-zero exit code on warnings as well as errors
strict: true

# The role itself is linted from its own directory; the Molecule converge
# playbooks reference it by name without the role being present on the lint
# machine, so mock it for the syntax check.
mock_roles:
  - certmonitor_vault
